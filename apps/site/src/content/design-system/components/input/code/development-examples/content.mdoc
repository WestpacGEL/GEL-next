### Default

```tsx
<div className="flex flex-col gap-4">
  <div>
    <p className="typography-body-10 text-text-muted">
      <em>Default</em>
    </p>
  </div>
  <Input />
</div>
```

### Text area sizes

```tsx
<div className="flex flex-col gap-4">
  <Input placeholder="small" className="w-full" size="small" />
  <Input placeholder="medium" className="w-full" size="medium" />
  <Input placeholder="large" className="w-full" size="large" />
  <Input placeholder="xlarge" className="w-full" size="xlarge" />
</div>
```

### Different status

```jsx
<div className="flex flex-col gap-4">
  <p className="typography-body-10 text-text-muted">
    <em>Invalid</em>
  </p>
  <div>
    <Input invalid placeholder="Invalid" />
  </div>

  <p className="typography-body-10 text-text-muted">
    <em>Disabled</em>
  </p>
  <div>
    <Input disabled placeholder="Disabled" />
  </div>

  <p className="typography-body-10 text-text-muted">
    <em>Read-only</em>
  </p>
  <div>
    <Input readOnly value="This value is readonly" />
  </div>
</div>
```
