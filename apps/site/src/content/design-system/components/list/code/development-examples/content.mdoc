### Default list

```jsx
<div>
  <h1 className="typography-body-10 mb-2 italic text-text-muted">Default list</h1>
  <List>
    <ListItem>Default styled bullet list</ListItem>
    <List>
      <ListItem>Default styled bullet list</ListItem>
      <List>
        <ListItem>Default styled bullet list</ListItem>
      </List>
      <ListItem>Default styled bullet list</ListItem>
    </List>
    <ListItem>Default styled bullet list</ListItem>
  </List>
</div>
```

### List looks

```jsx
<div className="flex flex-col gap-4">
  <List type="bullet" look="primary">
    <ListItem>Styled bullet list - primary</ListItem>
  </List>
  <List type="bullet" look="hero">
    <ListItem>Styled bullet list - hero</ListItem>
  </List>
  <List type="bullet" look="success">
    <ListItem>Styled bullet list - success</ListItem>
  </List>
  <List type="bullet" look="danger">
    <ListItem>Styled bullet list - danger</ListItem>
  </List>
  <List type="bullet" look="link">
    <ListItem>Styled bullet list - link</ListItem>
  </List>
</div>
```

### List types

```jsx
<div className="flex flex-col gap-4">
  <List type="bullet">
    <ListItem>Styled bullet list</ListItem>
    <ListItem>Styled bullet list</ListItem>
  </List>
  <List type="link">
    <ListItem href="#">Styled link list</ListItem>
    <ListItem href="#">Styled link list</ListItem>
  </List>
  <List type="tick">
    <ListItem>Styled tick list</ListItem>
    <ListItem>Styled tick list</ListItem>
  </List>
  <List type="cross">
    <ListItem>Styled cross list</ListItem>
    <ListItem>Styled cross list</ListItem>
  </List>
  <List type="ordered">
    <ListItem>Styled ordered list</ListItem>
    <ListItem>Styled ordered list</ListItem>
  </List>
  <List type="unstyled">
    <ListItem>Unstyled list</ListItem>
    <ListItem>Unstyled list</ListItem>
  </List>
  <List type="icon" icon={GithubIcon}>
    <ListItem>Styled icon list</ListItem>
    <ListItem>Styled icon list</ListItem>
  </List>
</div>
```

### List spacing

```jsx
<div>
  <h1 className="typography-body-10 mb-2 italic text-text-muted">Medium</h1>
  <List type="bullet" className="mb-4" spacing="medium">
    <ListItem>Styled bullet list</ListItem>
    <ListItem>Styled bullet list</ListItem>
    <ListItem>Styled bullet list</ListItem>
  </List>
  <h1 className="typography-body-10 mb-2 italic text-text-muted">Large</h1>
  <List type="bullet" className="mb-4" spacing="large">
    <ListItem>Styled bullet list</ListItem>
    <ListItem>Styled bullet list</ListItem>
    <ListItem>Styled bullet list</ListItem>
  </List>
</div>
```
