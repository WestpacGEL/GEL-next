### Button looks - default

```jsx
<div className="flex gap-0.5">
  <Button>Default standard</Button>
  <Button soft>Default soft</Button>
</div>
```

### Button looks - standard

```jsx
<div className="flex gap-0.5">
  <Button look="primary">Primary standard</Button>
  <Button look="hero">Hero standard</Button>
  <Button look="faint">Faint standard</Button>
  <Button look="link">Link</Button>
  <Button look="unstyled">Unstyled</Button>
</div>
```

### Button looks - soft

```jsx
<div className="flex gap-0.5">
  <Button look="primary" soft>
    Primary soft
  </Button>
  <Button look="hero" soft>
    Hero soft
  </Button>
  <Button look="faint" soft>
    Faint soft
  </Button>
</div>
```

### Button sizes

```jsx
<div className="flex flex-col gap-0.5">
  <div className="flex flex-wrap gap-0.5">
    <Button size="xlarge">Extra large: 48px</Button>
    <Button size="large">Large: 42px</Button>
    <Button size="medium">Medium (default): 36px</Button>
    <Button size="small">Small: 30px</Button>
  </div>
</div>
```

### Responsive sizing

```jsx
<div className="flex flex-col gap-2">
  <Button size={{ initial: 'xlarge', md: 'medium' }}>Responsive size</Button>
  <Button size={{ initial: 'small', xsl: 'medium', sm: 'large', md: 'xlarge' }}>Responsive size</Button>
</div>
```

### Block-level buttons

```jsx
<div className="flex flex-col gap-2">
  <Button block>Block-level button</Button>
  <Button block={{ initial: true, sm: false }}>Responsive block-level button</Button>
</div>
```

### Buttons with icons

```jsx
<div>
  <div className="flex items-center gap-2 mb-2">
    <Button iconBefore={SpaIcon}>Filled icon before</Button>
    <Button iconAfter={SpaIcon}>Filled icon after</Button>
  </div>
  <Hr />
  <div className="flex items-center gap-2">
    <Button iconBefore={SpaIcon} iconLook="outline">
      Outlined icon after
    </Button>
    <Button iconAfter={SpaIcon} iconLook="outline">
      Outlined icon after
    </Button>
  </div>
</div>
```

### Button as a link

```jsx
<Button tag="a" href="">
  Link example
</Button>
```
