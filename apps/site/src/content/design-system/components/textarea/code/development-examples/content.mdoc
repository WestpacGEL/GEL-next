### Default

```tsx
<Textarea />
```

---

### Text area sizes

```tsx
<Textarea size="small" placeholder="small" className="w-full" />

// other sizes
() => {
  const SIZES = ['medium', 'large', 'xlarge'] as const;
  return (



      <div className="flex flex-col gap-4">
        {SIZES.map(size => (
          <div key={size}>
            <Textarea placeholder={size} className="w-full" size={size} />
          </div>
        ))}
      </div>

  );
};
```

---

### Fix-width text area

```jsx
<Textarea width={20} /> 
```

---

### Invalid text area

```jsx
<Textarea invalid placeholder="Invalid" />

```

---

### Disabled text area

```jsx
<Textarea disabled placeholder="Disabled" />

```

---

### Read-only text area

```jsx
<Textarea readOnly defaultValue="Your application has been submitted." />
```
