### Default dropdown

```jsx
<Dropdown text="Default dropdown">
  <p className="text-text-body">Example dropdown content ...</p>
</Dropdown>
```

### Dropdown with headings

```jsx
<Dropdown text="Dropdown with headings" look="primary" soft>
  <DropdownHeading>Dropdown heading #1</DropdownHeading>
  <p className="text-text-body">Example dropdown content...</p>
  <DropdownHeading>Dropdown heading #2</DropdownHeading>
  <p className="text-text-body">Example dropdown content...</p>
</Dropdown>
```

### Dropdown sizes

```jsx
<div className="flex flex-col items-start gap-y-2">
  <Dropdown text="Small dropdown" dropdownSize="small" look="primary" soft>
    <DropdownHeading>130px min.</DropdownHeading>
  </Dropdown>
  <Dropdown text="Medium dropdown" dropdownSize="medium" look="primary" soft>
    <DropdownHeading>190px min.</DropdownHeading>
  </Dropdown>
  <Dropdown text="Large dropdown" dropdownSize="large" look="primary" soft>
    <DropdownHeading>250px min.</DropdownHeading>
  </Dropdown>
</div>
```

### Dropdown button sizes

```jsx
<div className="flex flex-col items-start gap-y-2">
  <Dropdown text="Small dropdown button" size="small" look="primary" soft>
    <DropdownHeading>Dropdown example</DropdownHeading>
  </Dropdown>
  <Dropdown text="Medium dropdown button" size="medium" look="primary" soft>
    <DropdownHeading>Dropdown example</DropdownHeading>
  </Dropdown>
  <Dropdown text="Large dropdown button" size="large" look="primary" soft>
    <DropdownHeading>Dropdown example</DropdownHeading>
  </Dropdown>
</div>
```
